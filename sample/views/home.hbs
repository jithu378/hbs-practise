<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f6f7f2">
    <meta name="description" content="Discover something you'll love at Shop Karo. Browse the collection or add a product to your store.">
    <title>Shop Karo — Find your kind of good</title>
    <link rel="stylesheet" href="/css/home.css">
</head>
<body>
    <header class="site-header">
        <a class="brand" href="/product/" aria-label="Shop Karo home">
            <span class="brand-mark" aria-hidden="true">s</span>
            <span>shop<span class="brand-accent">karo</span></span>
        </a>

        <nav class="main-nav" aria-label="Main navigation">
            <a class="nav-link active" href="/product/" aria-current="page">Home</a>
            <a class="nav-link" href="/product/display">View Products</a>
            <a class="nav-link" href="/product/form">Add Product</a>
            <a class="nav-link" href="/user/login">login Here</a>
        </nav>

        <a class="header-cta" href="/product/display">
            Explore the shop <span aria-hidden="true">↗</span>
        </a>
    </header>

    <main>
        <section class="hero">
            <div class="hero-copy">
                <p class="eyebrow"><span class="eyebrow-dot"></span> A little joy, delivered</p>
                <h1>Find your<br>kind of <span>good.</span></h1>
                <p class="hero-description">
                    The things you love, all in one place. Browse our collection and find a new favorite today.
                </p>
                <div class="hero-actions">
                    <a class="button button-primary" href="/product/display">
                        Shop the collection <span aria-hidden="true">→</span>
                    </a>
                    <a class="text-link" href="/product/form">Have something to sell? <span aria-hidden="true">↗</span></a>
                </div>
                <div class="hero-note">
                    <span class="note-stars" aria-hidden="true">★★★★★</span>
                    <span>Good finds. Great vibes. Every time.</span>
                </div>
            </div>

            <div class="hero-art" aria-label="A colorful selection of products">
                <div class="art-sun"></div>
                <div class="art-label"><span>THE GOOD<br>STUFF</span><span class="label-sparkle" aria-hidden="true">✳</span></div>
                <div class="product-tile tile-main">
                    <span class="tile-tag">JUST FOR YOU</span>
                    <span class="tile-emoji" aria-hidden="true">👜</span>
                    <span class="tile-caption">Everyday favorites</span>
                </div>
                <div class="product-tile tile-small tile-a">
                    <span class="tile-emoji" aria-hidden="true">🎧</span>
                </div>
                <div class="product-tile tile-small tile-b">
                    <span class="tile-emoji" aria-hidden="true">👟</span>
                </div>
                <span class="art-sparkle sparkle-one" aria-hidden="true">✳</span>
                <span class="art-sparkle sparkle-two" aria-hidden="true">✦</span>
                <div class="floating-note"><span>✦</span> Picked with love</div>
            </div>
        </section>

        <section class="discovery" aria-labelledby="discovery-title">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">YOUR NEXT GOOD FIND</p>
                    <h2 id="discovery-title">A shop full of <span>possibilities.</span></h2>
                </div>
                <a class="section-link" href="/product/display">See everything <span aria-hidden="true">→</span></a>
            </div>

            <div class="discovery-grid">
                <a class="discovery-card card-coral" href="/product/display">
                    <span class="category-icon" aria-hidden="true">✳</span>
                    <span class="category-copy"><strong>Discover something new</strong><span>Browse all the latest finds</span></span>
                    <span class="card-arrow" aria-hidden="true">↗</span>
                </a>
                <a class="discovery-card card-lime" href="/product/form">
                    <span class="category-icon" aria-hidden="true">＋</span>
                    <span class="category-copy"><strong>Make it yours</strong><span>Add a product to the shop</span></span>
                    <span class="card-arrow" aria-hidden="true">↗</span>
                </a>
                <a class="discovery-card card-lavender" href="/product/display">
                    <span class="category-icon" aria-hidden="true">♡</span>
                    <span class="category-copy"><strong>Find a new favorite</strong><span>Good things are waiting</span></span>
                    <span class="card-arrow" aria-hidden="true">↗</span>
                </a>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <a class="brand footer-brand" href="/product/">
            <span class="brand-mark" aria-hidden="true">s</span>
            <span>shop<span class="brand-accent">karo</span></span>
        </a>
        <p>A little joy in every find.</p>
        <a href="/product/display">Start exploring <span aria-hidden="true">→</span></a>
    </footer>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f6f7f2">
    <meta name="description" content="Browse the latest finds at Shop Karo.">
    <title>Our Products — Shop Karo</title>
    <link rel="stylesheet" href="/css/display.css">
</head>
<body>
    <header class="site-header">
        <a class="brand" href="/product/" aria-label="Shop Karo home">
            <span class="brand-mark" aria-hidden="true">s</span>
            <span>shop<span class="brand-accent">karo</span></span>
        </a>

        <nav class="main-nav" aria-label="Main navigation">
            <a class="nav-link" href="/product/">Home</a>
            <a class="nav-link" href="/product/form">Add Product</a>
            <a class="nav-link active" href="/product/display" aria-current="page">View Product</a>
            <a class="nav-link" href="/user/logout" class="logout-btn">Logout</a>

        </nav>

        <a class="header-cta" href="/product/form">
            Add a product <span aria-hidden="true">＋</span>
        </a>
    </header>

    <main class="page-main">
        <section class="collection-intro" aria-labelledby="page-title">
            <div class="intro-copy">
                <p class="eyebrow"><span class="eyebrow-dot"></span> A LITTLE JOY, DELIVERED</p>
                <h1 id="page-title">Good finds,<br><span>right here.</span></h1>
                <p class="intro-description">Explore the collection and find something you'll love. Your next favorite might be just a click away.</p>
            </div>
            <a class="intro-cta" href="/product/form">
                Share something good <span aria-hidden="true">→</span>
            </a>
        </section>

        <section class="product-section" aria-labelledby="collection-title">
            <div class="section-heading">
                <h2 id="collection-title">The collection</h2>
                <span class="section-note">Thoughtfully shared. Ready to discover.</span>
            </div>

            <div class="product-container">
                {{#each data}}
                <article class="product-card">
                    <a class="product-visual" href="/product/singleproduct/{{_id}}" aria-label="View {{productName}}">
                        {{#if productImage}}
                        <img src="{{productImage}}" alt="{{productName}}" loading="lazy">
                        {{else}}
                        <span class="product-placeholder" aria-hidden="true">✦</span>
                        {{/if}}
                    </a>

                    <div class="product-card-content">
                        <h3>{{productName}}</h3>
                        <a href="/product/singleproduct/{{_id}}" class="view-btn" aria-label="View {{productName}}">
                            View product <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </article>
                {{else}}
                <div class="no-products">
                    <span class="empty-icon" aria-hidden="true">✦</span>
                    <h3>Nothing on the shelf just yet</h3>
                    <p>Add the first product and give it a place to shine.</p>
                    <a class="empty-link" href="/product/form">Add a product <span aria-hidden="true">→</span></a>
                </div>
                {{/each}}
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <a href="/product/">← Back to Shop Karo home</a>
        <span>A little joy in every find.</span>
    </footer>
</body>
</html>
